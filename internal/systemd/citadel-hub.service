[Unit]
Description=Obsidian Citadel Control Plane Hub
After=network.target dbus.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /home/jack/system-mode-switcher/services/hub/main.py
WorkingDirectory=/home/jack/system-mode-switcher
Environment="PYTHONPATH=/home/jack/.local/lib/python3.12/site-packages:/home/jack/system-mode-switcher"
# The desktop user's config — the same file the dashboard saves profiles to.
# Only profile values are read from it; commands come from the root-owned
# /etc/obsidian-citadel/citadel.toml (or built-in defaults).
Environment="CITADEL_CONFIG=/home/jack/obsidian-citadel.toml"
# Only this user (and root) may connect to /run/citadel/hub.sock
Environment="CITADEL_USER=jack"
RuntimeDirectory=citadel
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5

# Relaxed sandboxing — the reconciler needs to run systemctl, write to
# /proc/sys, /sys/fs/cgroup, /sys/devices, /tmp (temp apply scripts), etc.
# NoNewPrivileges and ProtectSystem=full were blocking all of that.
ProtectSystem=false
ProtectHome=false

# Safe scheduling — never starve the system
CPUSchedulingPolicy=other
IOSchedulingClass=best-effort
Nice=5

[Install]
WantedBy=multi-user.target
